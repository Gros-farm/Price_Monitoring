{
  "auchan": {
    "name": "Ашан",
    "source": "auchan.ru",
    "dataFile": "auchan-products.json",
    "providers": [
      {
        "id": "direct",
        "name": "Ашан напрямую",
        "source": "auchan.ru",
        "timeoutSeconds": 180,
        "command": [
          "scripts/fetch_auchan.py",
          "--limit",
          "120"
        ]
      },
      {
        "id": "aggregator-kuper",
        "name": "Ашан через Купер",
        "source": "kuper.ru",
        "timeoutSeconds": 220,
        "command": [
          "scripts/fetch_aggregator.py",
          "--provider",
          "kuper",
          "--store",
          "auchan",
          "--limit",
          "120",
          "--query-limit",
          "8",
          "--browser-fallback",
          "--headless"
        ]
      },
      {
        "id": "aggregator-yandex",
        "name": "Ашан через Яндекс Еду",
        "source": "eda.yandex.ru",
        "timeoutSeconds": 220,
        "command": [
          "scripts/fetch_aggregator.py",
          "--provider",
          "yandex",
          "--store",
          "auchan",
          "--limit",
          "120",
          "--query-limit",
          "8",
          "--browser-fallback",
          "--headless"
        ]
      }
    ]
  },
